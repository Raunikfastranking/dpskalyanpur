w-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); margin-top: 0.5rem; margin-bottom: 0px; font-size: medium; --tw-text-opacity: 1; color: rgb(75, 85, 99); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;">The school is divided into Houses to promote collective responsibility, solidarity, team spirit, and healthy competition. The six Houses are:&nbsp;<span style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); font-weight: bolder;">Bluebells, Daffodils, Iris, Orchid, Shamrock, and Tulips.</span>&nbsp;Each House is managed by House Wardens, House Captains, Vice Captains, and&nbsp;Prefects.</p><p class="mt-2 text-[16px] text-gray-600" style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); margin-top: 0.5rem; margin-bottom: 0px; font-size: medium; --tw-text-opacity: 1; color: rgb(75, 85, 99); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;">Houses compete in various Inter-House Competitions across fields like academics, co-curricular activities, and sports. A Rolling Trophy is awarded to the House with the maximum points at the end of the academic&nbsp;session.</p>";s:12:"content_type";s:4:"text";s:10:"image_path";N;s:9:"image_url";N;s:8:"link_url";N;s:10:"video_path";N;s:9:"video_url";N;s:10:"table_data";N;s:14:"accordion_data";N;s:5:"order";i:1;s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T07:45:57.297000Z";s:10:"updated_at";s:27:"2025-09-22T07:45:57.297000Z";s:15:"page_section_id";s:4:"1770";s:15:"content_heading";N;s:9:"alignment";N;s:9:"image_alt";N;s:11:"column_type";N;s:5:"width";s:2:"50";s:11:"image_width";N;s:12:"image_height";N;s:15:"content_item_id";N;s:17:"content_item_type";N;}}}}}}s:15:"leadership_data";a:2:{s:7:"success";b:1;s:4:"data";a:20:{s:2:"id";i:1099;s:5:"title";s:35:"Leadership Programme Page Kalyanpur";s:16:"meta_description";N;s:13:"meta_keywords";N;s:6:"status";s:9:"published";s:8:"template";s:7:"default";s:10:"created_at";s:27:"2025-09-22T03:49:29.480000Z";s:10:"updated_at";s:27:"2025-09-22T07:48:17.710000Z";s:4:"slug";s:35:"leadership-programme-page-kalyanpur";s:11:"language_id";s:1:"1";s:13:"language_code";s:2:"en";s:17:"translation_group";s:26:"page_group_1758532769_1890";s:8:"language";s:2:"en";s:9:"school_id";s:1:"1";s:9:"branch_id";s:1:"9";s:16:"breadcrumb_style";s:7:"default";s:11:"breadcrumbs";N;s:12:"page_heading";s:35:"Leadership Programme Page Kalyanpur";s:16:"default_sections";s:1:"3";s:8:"sections";a:3:{i:0;a:24:{s:2:"id";i:1774;s:5:"title";s:29:"hero banner section kalyanpur";s:11:"description";N;s:5:"order";i:1;s:6:"layout";s:7:"content";s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T07:46:36.287000Z";s:10:"updated_at";s:27:"2025-09-22T07:46:36.287000Z";s:7:"page_id";s:4:"1099";s:7:"c