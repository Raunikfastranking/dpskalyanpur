</td>
<td style="vertical-align: top; padding: 5pt 5pt 5pt 5pt; overflow: hidden; overflow-wrap: break-word; border: solid #000000 0.5pt;" bis_size="{&quot;x&quot;:128,&quot;y&quot;:5756,&quot;w&quot;:136,&quot;h&quot;:85,&quot;abs_x&quot;:494,&quot;abs_y&quot;:6722}">
<p style="line-height: 1.7999999999999998; text-align: center; margin-top: 10pt; margin-bottom: 0pt;"><span style="font-size: 12pt; color: #000000; background-color: transparent; font-weight: bold; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;">Morning Anchor</span></p>
</td>
<td style="vertical-align: top; padding: 5pt 5pt 5pt 5pt; overflow: hidden; overflow-wrap: break-word; border: solid #000000 0.5pt;" bis_size="{&quot;x&quot;:264,&quot;y&quot;:5756,&quot;w&quot;:145,&quot;h&quot;:85,&quot;abs_x&quot;:630,&quot;abs_y&quot;:6722}">
