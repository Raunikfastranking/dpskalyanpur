round_color";s:7:"#ffffff";s:10:"text_color";s:7:"#333333";s:11:"padding_top";s:2:"50";s:14:"padding_bottom";s:2:"50";s:15:"content_item_id";N;s:17:"content_item_type";N;s:17:"section_layout_id";N;s:7:"columns";a:0:{}}i:1;a:24:{s:2:"id";i:1702;s:5:"title";s:27:"Cafeteria section kalyanpur";s:11:"description";N;s:5:"order";i:2;s:6:"layout";s:7:"content";s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T07:11:27.080000Z";s:10:"updated_at";s:27:"2025-09-22T07:11:27.080000Z";s:7:"page_id";s:4:"1048";s:7:"content";N;s:15:"content_heading";N;s:15:"table_json_data";N;s:19:"accordion_json_data";N;s:17:"gallery_json_data";N;s:12:"section_type";s:7:"content";s:9:"alignment";s:4:"left";s:16:"background_color";s:7:"#ffffff";s:10:"text_color";s:7:"#333333";s:11:"padding_top";s:2:"50";s:14:"padding_bottom";s:2:"50";s:15:"content_item_id";N;s:17:"content_item_type";N;s:17:"section_layout_id";N;s:7:"columns";a:2:{i:0;a:25:{s:2:"id";i:666;s:5:"title";s:33:"Cafeteria image section kalyanpur";s:7:"content";s:5630:"<p><span style="color: #4b5563; font-family: ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'; font-size: medium;">Our school cafeteria is more than just a place to eat &mdash; it is a space where students refuel, relax, and reconnect. With a focus on health, hygiene, and nutrition, the cafeteria offers a variety of wholesome and well-balanced meals that cater to diverse tastes and dietary needs.</span><br style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-scroll-snap-strictness: proximity; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; color: #4b5563; font-family: ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'; font-size: medium; border: 0px solid #e5e7eb;"><br style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-scroll-snap-strictness: proximity; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; color: #4b5563; font-family: ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'; font-size: medium; border: 0px solid #e5e7eb;"><span style="color: #4b5563; font-family: ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'; font-size: medium;">The menu is thoughtfully curated to include fresh fruits, vegetables, whole grains, and protein-rich options, while limiting processed and fried foods. Hygienic food preparation and safe serving practices are strictly followed, ensuring that students enjoy their meals in a clean and comfortable environment.</span><br style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-scroll-snap-strictness: proximity; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; color: #4b5563; font-family: ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'; font-size: medium; border: 0px solid #e5e7eb;"><br style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-scroll-snap-strictness: proximity; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; color: #4b5563; font-family: ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'; font-size: medium; border: 0px solid #e5e7eb;"><span style="color: #4b5563; font-family: ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'; font-size: medium;">In addition to promoting healthy eating habits, the cafeteria fosters a sense of community as students and staff come together during breaks. Regular feedback from students helps us enhance food quality and variety, making the cafeteria experience both enjoyable and nourishing.</span><br style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-scroll-snap-strictness: proximity; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; color: #4b5563; font-family: ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'; font-size: medium; border: 0px solid #e5e7eb;"><br style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-scroll-snap-strictness: proximity; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; color: #4b5563; font-family: ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'; font-size: medium; border: 0px solid #e5e7eb;"><span style="color: #4b5563; font-family: ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'; font-size: medium;">We believe that good nutrition plays a vital role in supporting academic performance and overall well-being &mdash; and our cafeteria is committed to making every meal&nbsp;count.</span></p>";s:12:"content_type";s:5:"image";s:10:"image_path";s:79:"https://dps.allenhouseschools.com/upload/images/pages/1793856472_wAjQi1aFxr.png";s:9:"image_url";s:79:"https://dps.allenhouseschools.com/upload/images/pages/1793856472_wAjQi1aFxr.png";s:8:"link_url";N;s:10:"video_path";N;s:9:"video_url";N;s:10:"table_data";N;s:14:"accordion_data";N;s:5:"order";i:1;s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T07:11:53.677000Z";s:10:"updated_at";s:27:"2026-11-05T05:27:52.190000Z";s:15:"page_section_id";s:4:"1702";s:15:"content_heading";N;s:9:"alignment";N;s:9:"image_alt";N;s:11:"column_type";N;s:5:"width";s:2:"50";s:11:"image_width";N;s:12:"image_height";N;s:15:"content_item_id";N;s:17:"content_item_type";N;}i:1;a:25:{s:2:"id";i:667;s:5:"title";s:32:"Cafeteria text section kalyanpur";s:7:"content";s:10781:"<span style="color: rgb(75, 85, 99); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-size: medium;">Our school cafeteria is more than just a place to eat — it is a space where students refuel, relax, and reconnect. With a focus on health, hygiene, and nutrition, the cafeteria offers a variety of wholesome and well-balanced meals that cater to diverse tastes and dietary needs.</span><br style="--tw-border-spac