";N;s:15:"table_json_data";N;s:19:"accordion_json_data";N;s:17:"gallery_json_data";N;s:12:"section_type";s:7:"content";s:9:"alignment";s:4:"left";s:16:"background_color";s:7:"#ffffff";s:10:"text_color";s:7:"#333333";s:11:"padding_top";s:2:"50";s:14:"padding_bottom";s:2:"50";s:15:"content_item_id";N;s:17:"content_item_type";N;s:17:"section_layout_id";N;s:7:"columns";a:2:{i:0;a:25:{s:2:"id";i:645;s:5:"title";s:36:"Middle Stage image section kalyanpur";s:7:"content";s:0:"";s:12:"content_type";s:5:"image";s:10:"image_path";s:80:"https://dps.allenhouseschools.com/upload/images/pages/1758542715_gZj5jM31Fg.webp";s:9:"image_url";s:80:"https://dps.allenhouseschools.com/upload/images/pages/1758542715_gZj5jM31Fg.webp";s:8:"link_url";N;s:10:"video_path";N;s:9:"video_url";N;s:10:"table_data";N;s:14:"accordion_data";N;s:5:"order";i:1;s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T06:35:15.957000Z";s:10:"updated_at";s:27:"2025-09-22T06:35:15.957000Z";s:15:"page_section_id";s:4:"1660";s:15:"content_heading";N;s:9:"alignment";N;s:9:"image_alt";N;s:11:"column_type";N;s:5:"width";s:2:"50";s:11:"image_width";N;s:12:"image_height";N;s:15:"content_item_id";N;s:17:"content_item_type";N;}i:1;a:25:{s:2:"id";i:646;s:5:"title";s:35:"Middle Stage text section kalyanpur";s:7:"content";s:15368:"<span style="color: rgb(0, 0, 0); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-size: medium;">Advancing from the preparatory stage, when our students move to the middle stage, we focus on offering a solid background for the upcoming classes. We are dedicated to creating a stimulating and engaging learning environment for students in grades 6 to 8. We implement the SMART (Specific, Measurable, Achievable, Relevant, and Time-Bound) framework to deliver structured, goal-oriented, and impactful learning experiences.</span><br style="--tw-border-spacing-x: 0; --tw-border-spac