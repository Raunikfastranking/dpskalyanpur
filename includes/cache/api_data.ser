</div>";s:9:"image_url";s:162:"https://myschool-assets.s3.ap-south-1.amazonaws.com/dps/blogs_images/1795589800_Which_Stream_Is_Best_After_10th_Class_A_Complete_Guide_for_CBSE_Students_copy.webp";s:14:"image_alt_text";s:32:"Which stream best after 10 class";s:15:"last_updated_by";s:5:"10050";s:10:"created_at";s:27:"2026-11-25T06:56:41.650000Z";s:10:"updated_at";s:27:"2026-11-25T06:56:41.650000Z";s:7:"blog_id";s:2:"53";s:9:"branch_id";s:1:"9";s:9:"school_id";s:1:"1";s:13:"section_order";s:1:"1";}}s:10:"categories";a:0:{}s:3:"tag";a:9:{i:0;a:14:{s:2:"id";i:42;s:4:"name";s:18:"Best school kanpur";s:11:"description";N;s:6:"status";s:6:"active";s:14:"publish_status";s:9:"published";s:10:"sort_order";i:0;s:5:"color";s:7:"#667eea";s:9:"school_id";s:1:"1";s:9:"branch_id";s:1:"9";s:11:"language_id";N;s:10:"created_at";s:27:"2026-03-23T11:47:28.300000Z";s:10:"updated_at";s:27:"2026-03-27T05:35:30.037000Z";s:4:"slug";s:18:"Best school kanpur";s:5:"pivot";a:2:{s:7:"blog_id";s:2:"53";s:6:"tag_id";s:2:"42";}}i:1;a:14:{s:2:"id";i:43;s:4:"name";s:20:"Top school in kanpur";s:11:"description";N;s:6:"status";s:6:"active";s:14:"publish_status";s:9:"published";s:10:"sort_order";i:0;s:5:"color";s:7:"#667eea";s:9:"school_id";s:1:"1";s:9:"branch_id";s:1:"9";s:11:"language_id";N;s:10:"created_at";s:27:"2026-03-23T11:47:44.567000Z";s:10:"updated_at";s:27:"2026-03-27T05:34:49.047000Z";s:4:"slug";s:20:"Top school in kanpur";s:5:"pivot";a:2:{s:7:"blog_id";s:2:"53";s:6:"tag_id";s:2:"43";}}i:2;a:14:{s:2:"id";i:45;s:4:"name";s:28:"Best secondary school kanpur";s:11:"description";N;s:6:"status";s:6:"active";s:14:"publish_status";s:9:"published";s:10:"sort_order";i:0;s:5:"color";s:7:"#667eea";s:9:"school_id";s:1:"1";s:9:"branch_id";s:1:"9";s:11:"language_id";N;s:10:"created_at";s:27:"2026-03-23T11:48:17.877000Z";s:10:"updated_at";s:27:"2026-03-27T05:33:18.493000Z";s:4:"slug";s:28:"Best secondary school kanpur";s:5:"pivot";a:2:{s:7:"blog_id";s:2:"53";s:6:"tag_id";s:2:"45";}}i:3;a:14:{s:2:"id";i:46;s:4