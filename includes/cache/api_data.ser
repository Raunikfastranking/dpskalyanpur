ontain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); margin-top: 0.25rem; margin-bottom: 0px; font-size: medium; --tw-text-opacity: 1; color: rgb(107, 114, 128); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;">Our mission is to revolutionise education by providing an immersive, personalised and holistic learning experience to every child, cultivating intellectual agility, emotional intelligence and the mindset needed to thrive in a rapidly evolving global&nbsp;landscape</p>";s:12:"content_type";s:4:"text";s:10:"image_path";N;s:9:"image_url";N;s:8:"link_url";N;s:10:"video_path";N;s:9:"video_url";N;s:10:"table_data";N;s:14:"accordion_data";N;s:5:"order";i:1;s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T05:41:42.197000Z";s:10:"updated_at";s:27:"2025-09-22T05:41:42.197000Z";s:15:"page_section_id";s:4:"1562";s:15:"content_heading";N;s:9:"alignment";N;s:9:"image_alt";N;s:11:"column_type";N;s:5:"width";s:2:"50";s:11:"image_width";N;s:12:"image_height";N;s:15:"content_item_id";N;s:17:"content_item_type";N;}}}i:4;a:24:{s:2:"id";i:1564;s:5:"title";s:29:"Core Values section kalyanpur";s:11:"description";N;s:5:"order";i:5;s:6:"layout";s:7:"content";s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T05:42:04.997000Z";s:10:"updated_at";s:27:"2025-09-22T05:42:04.997000Z";s:7:"page_id";s:3:"987";s:7:"content";N;s:15:"content_heading";N;s:15:"table_json_data";N;s:19:"accordion_json_data";N;s:17:"gallery_json_data";N;s:12:"section_type";s:7:"content";s:9:"alignment";s:4:"left";s:16:"background_color";s:7:"#ffffff";s:10:"text_color";s:7:"#333333";s:11:"padding_top";s:2:"50";s:14:"padding_bottom";s:2:"50";s:15:"content_item_id";N;s:17:"content_item_type";N;s:17:"section_layout_id";N;s:7:"columns";a:2:{i:0;a:25:{s:2:"id";i:627;s:5:"title";s:34:"Core Values text section kalyanpur";s:7:"content";s:4030:"<h2 class="text-[30px] font-[700] text-blue-main  hr-line inline relative" style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); font-size: 30px; margin-top: 0px; margin-bottom: 0px; color: rgb(0, 82, 36); position: relative; display: inline; font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;">Core Values</h2><span style="color: rgb(0, 0, 0); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-size: medium;"></span><p class="text-[16px] text-gray-500 mt-1" style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); margin-top: 0.25rem; margin-bottom: 0px; font-size: medium; --tw-text-opacity: 1; color: rgb(107, 114, 128); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;">At the heart of our philosophy lies a commitment to redefining education. We stand strong against a one-size-fits-all approach and believe in crafting personalised learning experiences. We empower every child to think beyond boundaries, act with empathy, and lead with purpose. Our approach integrates academic rigour with real-world application. We nurture creativity, resilience, and global awareness because education should not be limited to exam preparation and good scores; it is about scoring well in all aspects of life. Together, let's build a future driven by excellence and&nbsp;purpose.</p>";s:12:"content_type";s:4:"text";s:10:"image_path";N;s:9:"image_url";N;s:8:"link_url";N;s:10:"video_path";N;s:9:"video_url";N;s:10:"table_data";N;s:14:"accordion_data";N;s:5:"order";i:1;s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T05:42:30.323000Z";s:10:"updated_at";s:27:"2025-09-22T05:42:30.323000Z";s:15:"page_section_id";s:4:"1564";s:15:"content_heading";N;s:9:"alignment";N;s:9:"image_alt";N;s:11:"column_type";N;s:5:"width";s:2:"50";s:11:"image_width";N;s:12:"image_height";N;s:15:"content_item_id";N;s:17:"content_item_type";N;}i:1;a:25:{s:2:"id";i:628;s:5:"title";s:35:"Core Values image section kalyanpur";s:7:"content";s:0:"";s:12:"content_type";s:5:"image";s:10:"image_path";s:80:"https://dps.allenhouseschools.com/upload/images/pages/1758539584_D4d4Hnk4q0.webp";s:9:"image_url";s:80:"https://dps.allenhouseschools.com/upload/images/pages/1758539584_D4d4Hnk4q0.webp";s:8:"link_url";N;s:10:"video_path";N;s:9:"video_url";N;s:10:"table_data";N;s:14:"accordion_data";N;s:5:"order";i:1;s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T05:43:04.920000Z";s:10:"updated_at";s:27:"2025-09-22T05:43:04.920000Z";s:15:"page_section_id";s:4:"1564";s:15:"content_heading";N;s:9:"alignment";N;s:9:"image_alt";N;s:11:"column_type";N;s:5:"width";s:2:"50";s:11:"image_width";N;s:12:"image_height";N;s:15:"content_item_id";N;s:17:"content_item_type";N;}}}i:5;a:25:{s:2:"id";i:12425;s:5:"title";s:9:"Test Card";s:11:"description";N;s:5:"order";i:6;s:6:"layout";s:4:"card";s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-10-03T05:25:28.837000Z";s:10:"updated_at";s:27:"2025-10-03T05:25:28.837000Z";s:7:"page_id";s:3:"987";s:7:"content";N;s:15:"content_heading";N;s:15:"table_json_data";N;s:19:"accordion_json_data";N;s:17:"gallery_json_data";N;s:12:"section_type";s:4:"card";s:9:"alignment";s:4:"left";s:16:"background_color";s:7:"#ffffff";s:10:"text_color";s:7:"#333333";s:11:"padding_top";s:2:"50";s:14:"padding_bottom";s:2:"50";s: