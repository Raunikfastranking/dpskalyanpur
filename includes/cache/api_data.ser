 font-size: medium;">10. Reflective Practice: Teachers engage in reflective practices, continuously refining their teaching methods to enhance student learning.</span>";s:15:"content_heading";N;s:15:"table_json_data";N;s:19:"accordion_json_data";N;s:17:"gallery_json_data";N;s:12:"section_type";s:7:"content";s:9:"alignment";s:4:"left";s:16:"background_color";s:7:"#ffffff";s:10:"text_color";s:7:"#333333";s:11:"padding_top";s:2:"50";s:14:"padding_bottom";s:2:"50";s:15:"content_item_id";N;s:17:"content_item_type";N;s:17:"section_layout_id";N;s:7:"columns";a:0:{}}}}}s:17:"middle_stage_data";a:2:{s:7:"success";b:1;s:4:"data";a:20:{s:2:"id";i:1035;s:5:"title";s:27:"Middle Stage Page Kalyanpur";s:16:"meta_description";N;s:13:"meta_keywords";N;s:6:"status";s:9:"published";s:8:"template";s:7:"default";s:10:"created_at";s:27:"2025-09-22T03:38:51.440000Z";s:10:"updated_at";s:27:"2025-09-22T06:36:03.463000Z";s:4:"slug";s:27:"middle-stage-page-kalyanpur";s:11:"language_id";s:1:"1";s:13:"language_code";s:2:"en";s:17:"translation_group";s:26:"page_group_1758532131_8584";s:8:"language";s:2:"en";s:9:"school_id";s:1:"1";s:9:"branch_id";s:1:"9";s:16:"breadcrumb_style";s:7:"default";s:11:"breadcrumbs";N;s:12:"page_heading";s:27:"Middle Stage Page Kalyanpur";s:16:"default_sections";s:1:"3";s:8:"sections";a:3:{i:0;a:24:{s:2:"id";i:1658;s:5:"title";s:29:"hero banner section kalyanpur";s:11:"description";N;s:5:"order";i:1;s:6:"layout";s:7:"content";s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T06:33:07.080000Z";s:10:"updated_at";s:27:"2025-09-22T06:33:07.080000Z";s:7:"page_id";s:4:"1035";s:7:"content";N;s:15:"content_heading";s:1653:"<h1 class="sm:text-[32px] sm:block hidden font-[700] text-white text-left sm:mb-1 hr-line relative leading-9 ml-[7rem]" style="--tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-g