</td>
<td style="vertical-align: top; padding: 5pt 5pt 5pt 5pt; overflow: hidden; overflow-wrap: break-word; border: solid #000000 0.5pt;" bis_size="{&quot;x&quot;:214,&quot;y&quot;:2735,&quot;w&quot;:403,&quot;h&quot;:85,&quot;abs_x&quot;:580,&quot;abs_y&quot;:3701}">
