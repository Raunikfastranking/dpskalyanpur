ple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-size: medium;">Our Indoor Gym provides a well-equipped, safe, and weather-proof space for students to engage in physical fitness and sports activities. With facilities for exercises, yoga, strength training, and indoor games, it promotes physical well-being, discipline, and a healthy lifestyle. The gym supports overall development by encouraging regular fitness routines and active participation in&nbsp;sports.</span>";s:12:"content_type";s:4:"text";s:10:"image_path";N;s:9:"image_url";N;s:8:"link_url";N;s:10:"video_path";N;s:9:"video_url";N;s:10:"table_data";N;s:14:"accordion_data";N;s:5:"order";i:1;s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T07:06:03.573000Z";s:10:"updated_at";s:27:"2025-09-22T07:06:03.573000Z";s:15:"page_section_id";s:4:"1692";s:15:"content_heading";N;s:9:"alignment";N;s:9:"image_alt";N;s:11:"column_type";N;s:5:"width";s:2:"50";s:11:"image_width";N;s:12:"image_height";N;s:15:"content_item_id";N;s:17:"content_item_type";N;}}}}}}s:11:"rivera_data";a:2:{s:7:"success";b:1;s:4:"data";a:20:{s:2:"id";i:1046;s:5:"title";s:44:"RIVERA: Our School Auditorium Page Kalyanpur";s:16:"meta_description";N;s:13:"meta_keywords";N;s:6:"status";s:9:"published";s:8:"template";s:7:"default";s:10:"created_at";s:27:"2025-09-22T03:42:03.997000Z";s:10:"updated_at";s:27:"2025-09-22T07:08:17.977000Z";s:4:"slug";s:43:"rivera-our-school-auditorium-page-kalyanpur";s:11:"language_id";s:1:"1";s:13:"language_code";s:2:"en";s:17:"translation_group";s:26:"page_group_1758532323_5716";s:8:"language";s:2:"en";s:9:"school_id";s:1:"1";s:9:"branch_id";s:1:"9";s:16:"breadcrumb_style";s:7:"default";s:11:"breadcrumbs";N;s:12:"page_heading";s:44:"RIVERA: Our School Auditorium Page Kalyanpur";s:16:"default_sections";s:1:"2";s:8:"sections";a:2:{i:0;a:24:{s:2:"id";i:1693;s:5:"title";s:29:"hero banner section kalyanpur";s:11:"description";N;s:5:"order";i:1;s:6:"layout";s:7:"