</td>
<td style="vertical-align: top; padding: 5pt 5pt 5pt 5pt; overflow: hidden; overflow-wrap: break-word; border: solid #000000 0.5pt;" bis_size="{&quot;x&quot;:85,&quot;y&quot;:5116,&quot;w&quot;:174,&quot;h&quot;:85,&quot;abs_x&quot;:451,&quot;abs_y&quot;:6082}">
