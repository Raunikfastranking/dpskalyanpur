 ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); margin-top: 0.5rem; margin-bottom: 0px; font-size: medium; --tw-text-opacity: 1; color: rgb(75, 85, 99); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;">In a rapidly evolving world, students need more than textbook knowledge. Our curriculum integrates 21st-century skills like communication, collaboration, digital literacy, and problem-solving. Through project-based learning, technology integration, and exposure to innovation, we equip students with the mindset and adaptability to thrive in a dynamic global&nbsp;landscape.</p>";s:12:"content_type";s:5:"image";s:10:"image_path";s:79:"https://dps.allenhouseschools.com/upload/images/pages/1759554286_47eCz05C6P.jpg";s:9:"image_url";s:79:"https://dps.allenhouseschools.com/upload/images/pages/1759554286_47eCz05C6P.jpg";s:8:"link_url";N;s:10:"video_path";N;s:9:"video_url";N;s:10:"table_data";N;s:14:"accordion_data";N;s:5:"order";i:1;s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-23T08:37:02.290000Z";s:10:"updated_at";s:27:"2025-10-03T23:34:46.930000Z";s:15:"page_section_id";s:4:"2227";s:15:"content_heading";N;s:9:"alignment";N;s:9:"image_alt";N;s:11:"column_type";N;s:5:"width";s:2:"50";s:11:"image_width";N;s:12:"image_height";N;s:15:"content_item_id";N;s:17:"content_item_type";N;}i:1;a:25:{s:2:"id";i:833;s:5:"title";s:56:"Embark on a Journey of Excellence text section kalyanpur";s:7:"content";s:12761:"<p class="mt-2 text-gray-600 text-[16px]" style