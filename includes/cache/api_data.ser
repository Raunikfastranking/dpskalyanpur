:"updated_at";s:27:"2026-09-23T10:20:40.217000Z";s:4:"slug";s:22:"history-page-kalyanpur";s:11:"language_id";s:1:"1";s:13:"language_code";s:2:"en";s:17:"translation_group";s:26:"page_group_1758531826_9088";s:8:"language";s:2:"en";s:9:"school_id";s:1:"1";s:9:"branch_id";s:1:"9";s:16:"breadcrumb_style";s:7:"default";s:11:"breadcrumbs";N;s:12:"page_heading";s:22:"History Page Kalyanpur";s:16:"default_sections";s:1:"0";s:8:"sections";a:1:{i:0;a:24:{s:2:"id";i:23009;s:5:"title";s:30:"Hero Banner  section kalyanpur";s:11:"description";N;s:5:"order";i:1;s:6:"layout";s:7:"content";s:9:"is_active";b:1;s:10:"created_at";s:27:"2026-09-23T16:03:49.727000Z";s:10:"updated_at";s:27:"2026-09-25T07:38:43.980000Z";s:7:"page_id";s:3:"989";s:7:"content";s:2425:"<div style="text-align: justify;"><font color="#033300"><br></font></div><div style="text-align: justify;"><span style="color: rgb(3, 51, 0);">Since its establishment in 1997, Delhi Public School, Kalyanpur, Kanpur has built a distinguished educational legacy grounded in knowledge, values, discipline, and the enduring belief that education should prepare children not merely for examinations, but for life. Guided by the motto Service Before Self, the school has continued to evolve with changing times while remaining firmly rooted in its core values and traditions. Today, this rich legacy finds expression in a dynamic and contemporary learning ecosystem that extends well beyond textbooks and conventional classroom learning. Experiential and project based learning, design thinking, technology and AI literacy, art integrated learning, Model United Nations, Youth Parliament, scientific exhibitions, sports, and diverse student led initiatives provide learners with meaningful opportunities to apply knowledge, collaborate effectively, communicate with confidence, and address real world challenges. The school places strong emphasis on nurturing student leadership and responsible citizenship. Through student councils, leadership programmes, and platforms such as Unscripted Conversations, students are encouraged to articulate their perspectives and engage in meaningful discussions on contemporary issues, including digital hygiene, digital footprints, and responsible digital agency. Recognising that every learner has a unique set of interests, abilities, and aspirations, the school provides career counselling to help students understand their strengths, explore emerging opportunities, and make informed choices about their future pathways. Student wellness counselling supports their social and emotional well-being, while parent counselling and engagement strengthen the partnership between home and school in fostering each child’s holistic development. The journey of DPS Kalyanpur reflects a simple yet powerful philosophy: Preserve what is timeless, embrace what is relevant, and prepare every child for what lies ahead. With its enduring legacy as its foundation and contemporary education as its pathway, DPS Kalyanpur continues to nurture learners who are knowledgeable, empathetic, resilient, creative, digitally responsible, and equipped to make a meaningful contribution to society.</span></div>";s:15:"content_heading";s:7643104:"<div style="text-align: center;"><img src="data:image/png;base64," alt=""></div>";s:15:"table_json_data";N;s:19:"accordion_json_data";N;s:17:"gallery_json_data";N;s:12:"section_type";s:7:"content";s:9:"alignment";s:6:"center";s:16:"background_color";s:7:"#ffffff";s:10:"text_color";s:7:"#333333";s:11:"padding_top";s:2:"50";s:14:"padding_bottom";s:2:"50";s:15:"content_item_id";N;s:17:"content_item_type";N;s:17:"section_layout_id";N;s:7:"columns";a:0:{}}}}}s:12:"society_data";a:2:{s:7:"success";b:1;s:4:"data";a:20:{s:2:"id";i:994;s:5:"title";s:26:"DPS Society Page Kalyanpur";s:16:"meta_description";N;s:13:"meta_keywords";N;s:6:"status";s:9:"published";s:8:"template";s:7:"default";s:10:"created_at";s:27:"2025-09-22T03:34:31.113000Z";s:10:"updated_at";s:27:"2025-09-22T05:54:50.730000