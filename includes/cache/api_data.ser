<td style="vertical-align: top; padding: 5pt 5pt 5pt 5pt; overflow: hidden; overflow-wrap: break-word; border: solid #000000 0.5pt;" bis_size="{&quot;x&quot;:22,&quot;y&quot;:835,&quot;w&quot;:113,&quot;h&quot;:75,&quot;abs_x&quot;:388,&quot;abs_y&quot;:1801}">
<p style="line-height: 1.7999999999999998; text-align: center; margin-top: 12pt; margin-bottom: 12pt;"><span style="font-size: 12pt; color: #000000; background-color: transparent; font-weight: bold; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;"><span style="font-family: Georgia;">Aspect</span></span></p>
</td>
<td style="vertical-align: top; padding: 5pt 5pt 5pt 5pt; overflow: hidden; overflow-wrap: break-word; border: solid #000000 0.5pt;" bis_size="{&quot;x&quot;:135,&quot;y&quot;:835,&quot;w&quot;:237,&quot;h&quot;:75,&quot;abs_x&quot;:501,&quot;abs_y&quot;:1801}">
