</td>
<td style="vertical-align: top; padding: 5pt 5pt 5pt 5pt; overflow: hidden; overflow-wrap: break-word; border: solid #000000 0.5pt;" bis_size="{&quot;x&quot;:206,&quot;y&quot;:2930,&quot;w&quot;:410,&quot;h&quot;:56,&quot;abs_x&quot;:572,&quot;abs_y&quot;:3896}">
