 problem&nbsp;solvers.</p>";s:12:"content_type";s:4:"text";s:10:"image_path";N;s:9:"image_url";N;s:8:"link_url";N;s:10:"video_path";N;s:9:"video_url";N;s:10:"table_data";N;s:14:"accordion_data";N;s:5:"order";i:1;s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T05:40:03.150000Z";s:10:"updated_at";s:27:"2025-09-22T05:40:03.150000Z";s:15:"page_section_id";s:4:"1561";s:15:"content_heading";N;s:9:"alignment";N;s:9:"image_alt";N;s:11:"column_type";N;s:5:"width";s:2:"50";s:11:"image_width";N;s:12:"image_height";N;s:15:"content_item_id";N;s:17:"content_item_type";N;}i:1;a:25:{s:2:"id";i:624;s:5:"title";s:30:"Vision image section kalyanpur";s:7:"content";s:0:"";s:12:"content_type";s:5:"image";s:10:"image_path";s:80:"https://dps.allenhouseschools.com/upload/images/pages/1758539435_QP2GqPNwHP.webp";s:9:"image_url";s:80:"https://dps.allenhouseschools.com/upload/images/pages/1758539435_QP2GqPNwHP.webp";s:8:"link_url";N;s:10:"video_path";N;s:9:"video_url";N;s:10:"table_data";N;s:14:"accordion_data";N;s:5:"order";i:1;s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T05:40:35.020000Z";s:10:"updated_at";s:27:"2025-09-22T05:40:35.020000Z";s:15:"page_section_id";s:4:"1561";s:15:"content_heading";N;s:9:"alignment";N;s:9:"image_alt";N;s:11:"column_type";N;s:5:"width";s:2:"50";s:11:"image_width";N;s:12:"image_height";N;s:15:"content_item_id";N;s:17:"content_item_type";N;}}}i:3;a:24:{s:2:"id";i:1562;s:5:"title";s:25:"Mission section kalyanpur";s:11:"description";N;s:5:"order";i:4;s:6:"layout";s:7:"content";s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T05:40:48.243000Z";s:10:"updated_at";s:27:"2025-09-22T05:40:48.243000Z";s:7:"page_id";s:3:"987";s:7:"content";N;s:15:"content_heading";N;s:15:"table_json_data";N;s:19:"accordion_json_data";N;s:17:"gallery_json_data";N;s:12:"section_type";s:7:"content";s:9:"alignment";s:4:"left";s:16:"background_color";s:7:"#ffffff";s:10:"text_color";s:7:"#333333";s:11:"padding_top";s:2:"50";s:14:"padding_bottom";s:2:"50";s:15:"content_item