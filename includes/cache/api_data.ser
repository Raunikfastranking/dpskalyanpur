&quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-size: medium;">Our school has separate Infirmaries for the Junior and Senior Wings, ensuring age-appropriate care and comfort. Each infirmary is equipped with comfortable beds, essential medical supplies, and a trained nurse to provide immediate first aid and health support. A modern Health Kiosk to monitor basic health parameters such as temperature, oxygen levels, BMI, and blood pressure. These facilities ensure a hygienic, safe, and responsive environment to safeguard students’ health and well-being.</span>";s:12:"content_type";s:4:"text";s:10:"image_path";N;s:9:"image_url";N;s:8:"link_url";N;s:10:"video_path";N;s:9:"video_url";N;s:10:"table_data";N;s:14:"accordion_data";N;s:5:"order";i:1;s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T07:10:02.630000Z";s:10:"updated_at";s:27:"2025-09-22T07:10:02.630000Z";s:15:"page_section_id";s:4:"1699";s:15:"content_heading";N;s:9:"alignment";N;s:9:"image_alt";N;s:11:"column_type";N;s:5:"width";s:2:"50";s:11:"image_width";N;s:12:"image_height";N;s:15:"content_item_id";N;s:17:"content_item_type";N;}}}}}}s:14:"cafeteria_data";a:2:{s:7:"success";b:1;s:4:"data";a:20:{s:2:"id";i:1048;s:5:"title";s:24:"Cafeteria Page Kalyanpur";s:16:"meta_description";N;s:13:"meta_keywords";N;s:6:"status";s:9:"published";s:8:"template";s:7:"default";s:10:"created_at";s:27:"2025-09-22T03:42:31.570000Z";s:10:"updated_at";s:27:"2025-09-22T07:12:17.617000Z";s:4:"slug";s:24:"cafeteria-page-kalyanpur";s:11:"language_id";s:1:"1";s:13:"language_code";s:2:"en";s:17:"translation_group";s:26:"page_group_1758532351_5756";s:8:"language";s:2:"en";s:9:"school_id";s:1:"1";s:9:"branch_id";s:1:"9";s:16:"breadcrumb_style";s:7:"default";s:11:"breadcrumbs";N;s:12:"page_heading";s:24:"Cafeteria Page Kalyanpur";s:16:"default_sections";s:1:"2";s:8:"sections";a:2:{i:0;a:24:{s:2:"id";i:1701;s:5:"title";s:29:"hero banner section kalyanpur";s:11:"description";N;s:5:"order";i:1;s:6:"layout";s:7:"content";s:9