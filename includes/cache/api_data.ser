;a:5:{i:0;a:15:{s:2:"id";i:279;s:5:"title";s:32:"Mother of Shivanshi Singh XII C3";s:8:"subtitle";N;s:11:"description";s:4014:"<!--StartFragment--><span style="color: rgb(229, 231, 235); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(0, 54, 24); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;">Hello everyone,</span><br style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; box-sizing: border-box; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); color: rgb(229, 231, 235); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(0, 54, 24); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;"><span style="color: rgb(229, 231, 235); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(0, 54, 24); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;">I'm the proud mother of Shivanshi Singh, a student of DPS Kalyanpur. As she graduates this year after being a part of this nurturing institution from PG to Class XII, I want to express my deepest gratitude to the school. This journey has been nothing short of remarkable a transformation from a little girl with tiny feet to a confident young woman with big dreams and strong wings. DPS Kalyanpur has not only enriched her academically, but also shaped her emotionally and socially, instilling values, curiosity, and responsibility at every step. Thank you for providing her the perfect environment to grow, learn, and flourish. You've truly played a beautiful part in shaping her &nbsp;future.</span><!--EndFragment-->";s:9:"image_url";s:51:"upload/images/carousel/68d12d1f12350_1758539039.jpg";s:8:"link_url";N;s:11:"button_text";N;s:11:"order_index";s:1:"1";s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T05:33:59.077000Z";s:10:"updated_at";s:27:"2025-09-22T05:33:59.077000Z";s:11:"carousel_id";s:2:"39";s:9:"image_alt";N;s:13:"image_caption";N;s:16:"mobile_image_url";N;}i:1;a:15:{s:2:"id";i:280;s:5:"title";s:41:"Ms. Neetu Kushwaha Mother of Manik Maurya";s:8:"subtitle";N;s:11:"description";s:4721:"<!--StartFragment--><p class="testimonial-text text-[16px] text-gray-200 text-center sm:text-left expanded" style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; box-sizing: border-box; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); margin: 0px; text-align: left; font-size: medium; --tw-text-opacity: 1; color: rgb(229, 231, 235); max-height: 200px; overflow: hidden auto; display: block; -webkit-line-clamp: unset; white-space: normal; font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(0, 54, 24); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;">As a mother, witnessing my son-Manik Maurya's transformative journey at DPS Kalyanpur since he joined school in Class 9, 2021 has been deeply gratifying. The school's nurturing ethos, coupled with the unwavering dedication of its educators and mentors, has fostered not just academic excellence but also emotional intelligence, integrity, discipline, and compassion. DPSK has provided him with a plethora of opportunities, each one refining his confidence, curiosity, and character. I remain profoundly grateful to the school for instilling in him lifelong values, a growth mindset, and the courage to lead with&nbsp;humility.</p><button class="moreless-button font-[600] text-white text-sm mt-1" style="--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; box-sizing: border-box; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); font-family: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-size: 0.875rem; font-weight: 600; line-height: 1.25rem; letter-spacing: inherit; color: rgb(255, 255, 255); margin: 0.25rem 0px 0px; padding: 0px; text-transform: none; appearance: button; background-color: transparent; background-image: none; cursor: pointer; --tw-text-opacity: 1; orphans: 2; widows: 2; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;"><br class="Apple-interchange-newline"><!--EndFragment-->

</button>";s:9:"image_url";s:51:"upload/images/carousel/68d12d1f13193_1758539039.jpg";s:8:"link_url";N;s:11:"button_text";N;s:11:"order_index";s:1:"2";s:9:"is_active";b:1;s:10:"created_at";s:27:"2025-09-22T05:33:59.077000Z";s:10:"updated_at";s:27:"2025-09-22T05:33:59.077000Z";s:11:"carousel_id";s:2:"39";s:9:"image_alt";N;s:13:"image_caption";N;s:16:"mobile_image_url";N;}i:2;a:15:{s:2:"id";i:20556;s:5:"title";s:37:"Parents of Syon Bhattacharjee, XII S5";s:8:"subtitle";N;s:11:"description";s:923:"<span style="background-color: rgb(4, 56, 0);"><font color="#ffffff">Our association with DPS Kalyanpur began in 2005; both our sons are from this school. Our elder son Sayak Bhattacharjee graduated in 2019, and currently our younger son Syon Bhattacharjee is studying in class XII. DPS Kalyanpur has been instrumental in Syon's academic journey for the past 15 years. We are deeply grateful to the school, as it has contributed immensely to his overall growth as a well-rounded student. The school has shaped him in many ways: to be disciplined, hard working, and to undertake challenges with determination. The best part of the school is that it encourages and nurtures all students to excel in diverse fields. We are very much thankful to the school for its constant encouragement and support to bring the best in the children. We wish the school all glory and many more laurels in the future. Best wishes.</font></span>";s:9:"image_url";s:51:"upload/images/carousel/696dd0a48a47f_1768804516.jpg";s:8:"link_url";N;s:11:"button_text";N;s:11:"order_index";s:1:"3";s:9:"is_active";b:1;s:10:"created_at";s:27:"2026-01-19T06:35:16.567000Z";s:10:"updated_at";s:27:"2026-01-19T06:36:11.333000Z";s:11:"carousel_id";s:2:"39";s:9:"image_alt";N;s:13:"image_caption";N;s:16:"mobile_image_url";N;}i:3;a:15:{s:2:"id";i:20557;s:5:"title";s:34:"Parents of Giyansh (Nursery Candy)";s:8:"subtitle";N;s:11:"description";s:3824:"<!--StartFragment--><meta charset="utf-8"><font color="#ffffff" style=""><b style="font-weight: normal;" id="docs-internal-guid-98834931-7fff-75cc-1219-c76c25cb6050"><p dir="ltr" style="text-align: left; line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-size: 11pt; font-family: Calibri, sans-serif; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(1, 51, 0);">Letting our child to go out into the big world and finding a school where our child could truly learn and grow was a tough riddle for us.</span></p><p dir="ltr" style="text-align: left; line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-size: 11pt; font-family: Calibri, sans-serif; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(1, 51, 0);">Now, as we near the end of our second year in DPS Kalyanpur, our level of satisfaction with our choice of school is truly off the charts.</span></p><p dir="ltr" style="text-align: left; line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-size: 11pt; font-family: Calibri, sans-serif; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(1, 51, 0);">We are extremely happy with the kind of activities organised at the school for our child’s physical, social and intellectual development. The well planned curriculum encourages our child to think beyond textbooks.</span></p><p dir="ltr" style="text-align: left; line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-size: 11pt; font-family: Calibri, sans-serif; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(1, 51, 0);">We are grateful to all the teachers, coordinators and respected Principal Ma’am for giving our child a solid head start.</span></p><p dir="ltr" style="text-align: left; line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-size: 11pt; font-family: Calibri, sans-serif; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(1, 51, 0);">We whole heartedly thank the school for providing a nurturing and warm environment every day.</span></p><p dir="ltr" style="text-align: left; line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-size: 11pt; font-family: Calibri, sans-serif; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(1, 51, 0);">We wish DPS Kalyanpur continued success.</span></p><p dir="ltr" style="text-align: left; line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-size: 11pt; font-family: Calibri, sans-serif; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(1, 51, 0);">- Dr Anjali &amp; Dr Gautam Kapoor&nbsp;</span></p><p dir="ltr" style="text-align: left; line-height: 1.38; margin-top: 0pt; margin-bottom: 10pt;"><span style="font-size: 11pt; font-family: Calibri, sans-serif; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(1, 51, 0);">Parents of Giyansh (Nursery Candy)</span></p></b><div style="background-color: rgb(3, 54, 2); text-align: left;"><br></div></font><!--EndFragment--><div style="text-align: left;"><br></div>";s:9:"image_url";s:52:"upload/images/carousel/696dd6b243f5e_1768806066.jpeg";s:8:"link_url";N;s:11:"button_text";N;s:11:"order_index";s:1:"4";s:9:"is_active";b:1;s:10:"created_at";s:27:"2026-01-19T07:01:06.280000Z";s:10:"updated_at";s:27:"2026-01-19T07:01:06.280000Z";s:11:"carousel_id";s:2:"39";s:9:"image_alt";N;s:13:"image_caption";N;s:16:"mobile_image_url";N;}i:4;a:15:{s:2:"id";i:20563;s:5:"title";s:57:"Mrs. Deepika Kukreti Parent of Ishita Kukreti Grade XI-S2";s:8:"subtitle";N;s:11:"description";s:590:"<span style="background-color: rgb(0, 87, 1);"><font color="#ffffff">When we were in Gurgaon and searching for a well-reputed school in Kanpur, we received a very positive feedback about DPS Kalyanpur. Based on these recommendations, we chose this school for our daughter, who joined in Class 11. Our experience has been very satisfying. The school is a promising institution that places equal emphasis on academics and extracurricular activities. The learning environment is focused, motivating, and respectful. We are pleased with our decision to enroll her at DPS Kalyanpur</font></span>";s:9:"image_url";s:52:"upload/images/carousel/69c0acbf4ab01_1774234815.jpeg";s:8:"link_url";N;s:11:"button_text";N;s:11:"order_index";s:1:"5";s:9:"is_active";b:1;s:10:"created_at";s:27:"2026-03-23T03:00:15.307000Z";s:10:"updated_at";s:27:"2026-03-23T03:00:15.307000Z";s:11:"carousel_id";s:2:"39";s:9:"image_alt";N;s:13:"image_caption";N;s:16:"mobile_image_url";N;}}s:6:"school";a:29:{s:2:"id";i:1;s:4:"name";s:19:"Delhi Public School";s:11:"description";s:19:"Delhi Public School";s:4:"logo";s:0:"";s:7:"website";s:0:"";s:5:"email";s:0:"";s:5:"phone";s:0:"";s:7:"address";s:0:"";s:4:"city";s:0:"";s:5:"state";s:0:"";s:7:"country";s:0:"";s:11:"postal_code";s:0:"";s:14:"principal_name";s:0:"";s:15:"principal_email";s:0:"";s:15:"principal_phone";s:0:"";s:16:"established_year";N;s:13:"accreditation";s:0:"";s:7:"mission";s:0:"";s:6:"vision";s:0:"";s:11:"core_values";s:0:"";s:6:"status";s:6:"active";s:10:"meta_title";s:0:"";s:16:"meta_description";s:0:"";s:13:"meta_keywords";s:0:"";s:8:"language";N;s:11:"language_id";s:1:"1";s:10:"created_at";s:27:"2025-08-07T20:31:54.000000Z";s:10:"updated_at";s:27:"2025-12-13T17:21:25.200000Z";s:4:"slug";s:18:"delhi-public-scool";}s:6:"branch";a:30:{s:2:"id";i:9;s:4:"name";s:9:"Kalyanpur";s:11:"description";s:13:"Dps Kalyanpur";s:11:"branch_code";s:0:"";s:7:"address";s:66:"287-295, Bithoor Rd, Singhpur, Kalyanpur,
